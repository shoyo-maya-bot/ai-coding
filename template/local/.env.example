# コピーして .env を作る（.env はコミットしない）
# ポートやパスワードを変えたら、アプリ側にも同じ値を環境変数で渡す（dev-environment の local/README.md の「ポート・パスワードを変えたとき」）。
# scripts/upload-sample.* は S3_PORT・S3_BUCKET をこのファイルから読む。
DB_NAME=sampledb
DB_USER=app
DB_PASSWORD=localpass
DB_PORT=5432
S3_PORT=9090
S3_BUCKET=sample-bucket
# S3_EMULATOR_IMAGE=<your-registry>/<s3-emulator>:<tag>
